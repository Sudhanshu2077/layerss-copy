# Copy to .env for local dev. NEVER commit a real .env with secrets.
# Backend is API-only on Render; frontend (Vercel) talks to it via VITE_API_URL.
PORT=4000
NODE_ENV=development

# Comma-separated allowlist for browser CORS (production). Example:
# FRONTEND_URL=https://layerss.vercel.app,https://www.layerss.in
# Leave empty in local dev to allow localhost only.
FRONTEND_URL=http://localhost:5173

# Persistent data dir: catalogue + uploads. Local default is src/data.
# On Render, mount a Persistent Disk at /data and set DATA_DIR=/data
# (see render.yaml). Ephemeral filesystem loses uploads on restart.
DATA_DIR=

# --- Admin auth (backend only, never VITE_*) ---
# Generate with: node backend/scripts/make-hash.js "a-long-random-password"
# Paste ONLY the hash output below (or into Render env vars).
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

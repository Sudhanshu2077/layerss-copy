{
  "name": "layerss",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "prebuild": "node -e \"try{require('fs').copyFileSync('backend/src/data/menu.json','api/menu-data.json')}catch(e){console.log('prebuild: menu sync skipped - '+e.message)}\"",
    "build": "npm install --prefix frontend && npm run build --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "start": "node backend/src/index.js",
    "start:backend": "npm start --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend"
  },
  "engines": {
    "node": ">=18"
  }
}
